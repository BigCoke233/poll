# ][/poll configuration: copy to .env. These values work for local development (make dev).

# Public URL, used in mailed links.
BASE_URL=http://localhost:8737
# Password for the admin pages at /a (user: admin).
ADMIN_PASSWORD=admin
# Receives notifications for polls the admin created. Required.
ADMIN_EMAIL=admin@example.com
# Outgoing mail. Required.
#   smtp://user:password@host:587   STARTTLS (production)
#   smtp+insecure://host:1025       no TLS, local Mailpit only
SMTP_URL=smtp+insecure://localhost:1025
SMTP_FROM=poll@example.com
# Anyone may create polls at /new and manage them via a mailed link. Default false: only the admin.
PUBLIC_CREATE=true
# Default theme: minimal, elegant, business, fun. Default minimal.
THEME=minimal
# Time zone for date options and calendar invites. Default UTC.
TZ=Europe/Vienna
